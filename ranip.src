ranip = function()
    reserved = [
        {"from": 1681915904, "to": 1686110207},     // 100.64.0.0 - 100.127.255.255
        {"from": 2851995648, "to": 2852061183},     // 169.254.0.0 - 169.254.255.255
        {"from": 2886729728, "to": 2887778303},     // 172.16.0.0 - 172.31.255.255
        {"from": 3221225472, "to": 3221225727},     // 192.0.0.0 - 192.0.0.255
        {"from": 3221225984, "to": 3221226239},     // 192.0.2.0 - 192.0.2.255
        {"from": 3227017984, "to": 3227018239},     // 192.88.99.0 - 192.88.99.255
        {"from": 3323068416, "to": 3323199487},     // 198.18.0.0 - 198.19.255.255
        {"from": 3325256704, "to": 3325256959},     // 198.51.100.0 - 198.51.100.255
        {"from": 3405803776, "to": 3405804031},     // 203.0.113.0 - 203.0.113.255
    ]

    is_reserved = function(num)
        for r in reserved
            if num >= r.from and num <= r.to then return true
        end for
        return false
    end function

    router = null

    while not router
        a = floor(rnd * 256)

        if a == 0 then continue
        if a == 10 then continue
        if a == 127 then continue
        if a >= 224 then continue

        b = floor(rnd * 256)
        c = floor(rnd * 256)
        d = floor(rnd * 256)

        num = a * 16777216 + b * 65536 + c * 256 + d
        if is_reserved(num) then continue

        addr = a + "." + b + "." + c + "." + d
        router = get_router(addr)
    end while

    return router.public_ip
end function

print ranip